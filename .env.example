# Database
DATABASE_URL="postgresql://clawdslist:clawdslist_dev_password@localhost:5432/clawdslist"

# Redis (for job queue)
REDIS_URL="redis://localhost:6379"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (for fiat payments)
STRIPE_SECRET_KEY="sk_test_your_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Object Storage (MinIO for local, S3 for production)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="clawdslist"
S3_SECRET_KEY="clawdslist_dev_password"
S3_BUCKET="clawdslist-media"
S3_REGION="us-east-1"

# Firecrawl (for URL ingestion)
FIRECRAWL_API_KEY="your_firecrawl_api_key"

# Crypto Payments (optional)
COINBASE_API_KEY="your_coinbase_api_key"
COINBASE_WEBHOOK_SECRET="your_coinbase_webhook_secret"

# Auth (optional - for production)
JWT_SECRET="your_jwt_secret_at_least_32_chars"
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"
