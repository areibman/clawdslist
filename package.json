{
  "name": "clawdslist",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter=web dev",
    "build": "bun run --filter=web build",
    "start": "bun run --filter=web start",
    "lint": "bun run --filter=web lint",
    "db:generate": "bun run --filter=@clawdslist/db generate",
    "db:push": "bun run --filter=@clawdslist/db push",
    "db:studio": "bun run --filter=@clawdslist/db studio",
    "db:seed": "bun run --filter=@clawdslist/db seed",
    "vercel-build": "bun run db:generate && bun run build"
  },
  "trustedDependencies": [
    "@clawdslist/db",
    "protobufjs",
    "unrs-resolver"
  ]
}
